{
  // Static site only: Cloudflare serves dist/ as static assets (no Worker script runs).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salahtimesnow",
  "compatibility_date": "2026-10-28",
  // Custom domains: Cloudflare creates the DNS records and SSL certificates on deploy.
  "routes": [
    { "pattern": "salahtimesnow.com", "custom_domain": true },
    { "pattern": "www.salahtimesnow.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
